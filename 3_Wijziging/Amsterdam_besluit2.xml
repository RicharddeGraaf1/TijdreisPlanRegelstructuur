         <Aanhef eId="formula_1" wId="formula_1">
            <Al>De raad van de gemeente Gemeenstestad </Al>
            <Al>gelezen het voorstel van burgemeester en wethouders van 26 juni 2019, nr. 2019-4542;</Al>
            <Al>Gelet op <ExtRef ref="https://wetten.overheid.nl/jci1.3:c:BWBR0005416&amp;titeldeel=III&amp;hoofdstuk=IX&amp;artikel=149"
                       soort="URL">Gemeentewet, art. 149</ExtRef>.</Al>
            <Al>besluit:</Al>
         </Aanhef>
         <Lichaam eId="body" wId="body">
            <WijzigArtikel eId="art_I" wId="gm0363_1__art_I">
               <Kop>
                  <Label>Artikel</Label>
                  <Nummer>I</Nummer>
               </Kop>
               <Wat>Het omgevingsplan Amsterdam opgenomen in <IntRef ref="cmp_A" scope="WijzigBijlage">Bijlage A</IntRef> kan worden vastgesteld.</Wat>
            </WijzigArtikel>
            <Artikel eId="art_II" wId="gm0363_1__art_II">
               <Kop>
                  <Label>Artikel</Label>
                  <Nummer>II</Nummer>
               </Kop>
               <Inhoud>
                  <Al>Dit besluit treedt in werking per 1 januari 2021.</Al>
               </Inhoud>
            </Artikel>
            <Artikel eId="art_III" wId="gm0363_1__art_III">
               <Kop>
                  <Label>Artikel</Label>
                  <Nummer>III</Nummer>
               </Kop>
               <Inhoud>
                  <Al>Het omgevingsplan van rechtswege vervalt voor het Pons-informatieobject van dit artikel.</Al>
               </Inhoud>
            </Artikel>
         </Lichaam>
         <Sluiting eId="formula_2" wId="formula_2">
